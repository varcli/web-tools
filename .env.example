# 变量必须以 VITE_ 为前缀才能暴露给外部读取
# 网站名称
VITE_APP_TITLE = 'Web-Tools'
# 简短描述
VITE_APP_DESC = '一个轻量的在线工具箱'
# 站点公开域名，用于生产 HTML 的 canonical 和 og:url
VITE_APP_SITE_URL = 'https://tools.varcli.com'

# ============ Vercel 部署说明 ============
# 1. 将本仓库推送到 GitHub
# 2. 在 vercel.com 导入该仓库，框架选择 Vite
#    - Build Command: pnpm build:prod
#    - Output Directory: dist
#    - Install Command: pnpm install
# 3. 需要的环境变量（在 Vercel 项目设置中配置，或复制本文件为 .env.development）：
#    VITE_APP_TITLE / VITE_APP_DESC / VITE_APP_SITE_URL 按需填写
